{
  "name": "huifeng",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:browser": "node tools/perf/regress.mjs",
    "perf": "node tools/perf/harness.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
